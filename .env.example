# Canal Seguro – variáveis de ambiente (exemplo)
# Copie para o painel da Hostinger (Environment Variables) ou para um .env local não versionado.

NODE_ENV=production
PORT=3000

# Segredos obrigatórios em produção
CS_JWT_SECRET=troque-por-um-segredo-longo
CS_CPF_PEPPER=troque-por-outro-segredo-longo
CS_MFA_ENCRYPTION_KEY=
CS_EMAIL_WEBHOOK_SECRET=

# Dados fora do docroot (store.json, anexos, db-config.json)
# Preferir STORE_DATA_DIR. Se omitido: {home}/private/canal-seguro-data
# STORE_DATA_DIR=
# (legado) CS_DATA_DIR — não use placeholder /home/USUARIO/...

# Frontend estático (opcional). Se omitido: server/public ou raiz do repo
# CS_FRONTEND_ROOT=

# App público (links de e-mail, etc.)
CS_PUBLIC_APP_URL=https://seudominio.com.br
CS_CORS_ORIGIN=https://seudominio.com.br

# --- MySQL Hostinger (Etapa 1+: config; Etapa 4+: persistência) ---
# Prioridade sobre Configurações → Banco de dados (arquivo).
CS_DB_ENABLED=0
CS_DB_HOST=localhost
CS_DB_PORT=3306
CS_DB_USER=
CS_DB_PASSWORD=
CS_DB_NAME=
# Opcional: chave só para criptografar senha em db-config.json
# CS_DB_CONFIG_KEY=

# E-mail
CS_MAIL_MODE=console
# CS_SMTP_HOST=
# CS_SMTP_PORT=587
# CS_SMTP_USER=
# CS_SMTP_PASS=
# CS_MAIL_FROM=
